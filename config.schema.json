{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/leighton-tidwell/agentic-asana-cli/main/config.schema.json",
  "title": "asn configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "token": { "type": "string", "minLength": 1 },
    "workspaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gid", "readOnly"],
        "properties": {
          "gid": { "type": "string", "pattern": "^[0-9]+$" },
          "name": { "type": "string" },
          "readOnly": { "type": "boolean" }
        }
      }
    }
  }
}
